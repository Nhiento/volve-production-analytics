    {
      "id": 7,
      "type": "timeseries",
      "title": "Downhole pressure, with flagged readings",
      "description": "Red points are readings the quality monitor rejected. On F-12, the gauge reads 0 bar while the well is flowing from 2010 on.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"volve\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor\" and r._field == \"value\" and r.well == \"${well}\")\n  |> filter(fn: (r) => contains(value: r.tag, set: [\"downhole_pressure\"]))\n  |> keep(columns: [\"_start\", \"_stop\", \"_time\", \"_value\", \"tag\"])\n  |> group(columns: [\"tag\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"volve\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dq_event\" and r._field == \"value\" and r.well == \"${well}\")\n  |> filter(fn: (r) => r.tag == \"downhole_pressure\")\n  |> keep(columns: [\"_time\", \"_value\", \"check\"])\n  |> group(columns: [\"check\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "displayName": "${__field.labels.tag}",
          "unit": "pressurebar"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "displayName",
                "value": "flagged: ${__field.labels.check}"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
