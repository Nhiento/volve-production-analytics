    {
      "id": 11,
      "type": "timeseries",
      "title": "Water cut",
      "description": "water / (oil + water), computed in the query from the oil_volume and water_volume tags.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"volve\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor\" and r._field == \"value\" and r.well == \"${well}\")\n  |> filter(fn: (r) => r.tag == \"oil_volume\" or r.tag == \"water_volume\")\n  |> keep(columns: [\"_start\", \"_stop\", \"_time\", \"_value\", \"tag\"])\n  |> group()\n  |> pivot(rowKey: [\"_time\", \"_start\", \"_stop\"], columnKey: [\"tag\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.oil_volume and exists r.water_volume and r.oil_volume + r.water_volume > 0.0)\n  |> map(fn: (r) => ({_start: r._start, _stop: r._stop, _time: r._time,\n                      _value: 100.0 * r.water_volume / (r.oil_volume + r.water_volume)}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "showPoints": "never"
          },
          "displayName": "water cut",
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
